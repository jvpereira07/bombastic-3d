{
  "name": "bombastic-3d",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start:test": "vite --open /?test",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p server",
    "server": "tsx server/index.ts",
    "start:online": "vite --host --open /?online"
  },
  "dependencies": {
    "@fontsource/pixelify-sans": "^5.3.0",
    "three": "0.169.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/three": "0.169.0",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  }
}
